--- new file: tatar/tatar/tatar/css/rtl.css (not in diff, included in full below) ---

@CHARSET "UTF-8";

/* =====================================================================
 * Shared Arabic / RTL stylesheet
 * ---------------------------------------------------------------------
 * Loaded ONLY when the active interface language is RTL (Arabic, and
 * any other RTL language later added to tz_is_rtl_lang() in
 * GameEngine/config.php). See tz_rtl_stylesheet_tag() in that file for
 * the loading logic and tz_html_dir_attrs() for the <html dir="..">
 * attribute this file assumes is present.
 *
 * Scope: this file only touches TEXT-FLOW chrome - navigation order,
 * sidebars, tables, forms, popups, footer. It intentionally does NOT
 * touch:
 *   - the village map / resource field overlay (Templates/field.tpl,
 *     #map, #village_map, #resfeld) - these are pixel-coordinate
 *     image maps, not text layout, and are explicitly kept LTR below.
 *   - the hero header widget (css/hero_header.css, #tzHeroBox and
 *     friends) - a hand-tuned absolutely-positioned icon cluster
 *     inside #mtop, kept LTR below.
 *   - any sprite/background-position values in compact.css /
 *     new_images.css - those are graphic-pack artwork, not layout.
 *   - numeric/coordinate/URL/ID strings - isolated with
 *     unicode-bidi/direction where they appear in shared markup.
 *
 * Everything here prefers CSS logical properties (margin-inline-*,
 * padding-inline-*, inset-inline-*, text-align:start/end) so it keeps
 * working if a second RTL language is ever added without edits.
 * ===================================================================== */

html[dir="rtl"] body {
    text-align: right;
}

/* ---------------------------------------------------------------------
 * 1) Protected LTR islands
 * ---------------------------------------------------------------------
 * Absolutely-positioned graphics that must keep their original x/y
 * math regardless of document direction. Forcing direction:ltr here
 * stops them from inheriting dir="rtl" from <html> and re-flowing.
 * unicode-bidi:isolate keeps their internal number/text runs from
 * being reordered by any RTL text that happens to sit near them.
 */
html[dir="rtl"] #mtop,
html[dir="rtl"] #village_map_wrap,
html[dir="rtl"] div#village_map,
html[dir="rtl"] div#map,
html[dir="rtl"] img#resfeld,
html[dir="rtl"] #wrapper,
html[dir="rtl"] #container,
html[dir="rtl"] #stime,
html[dir="rtl"] #ltime,
html[dir="rtl"] #res,
html[dir="rtl"] #resWrap {
    direction: ltr;
    unicode-bidi: isolate;
}

/* #mtop's own children (village/map/report/message nav icons, gold,
   plus button, day/night icon) keep their left-to-right reading order
   and pixel offsets exactly as designed. */
html[dir="rtl"] #mtop * {
    direction: ltr;
}

/* Resource bar values ("120/800" etc.) and the header gold/silver
   counters are numeric ratios - always LTR, never mirrored, wherever
   they appear outside #mtop/#res too (e.g. inside tables). */
html[dir="rtl"] .tzCoinValue,
html[dir="rtl"] td[id^="l"],
html[dir="rtl"] span.num,
html[dir="rtl"] td.num,
html[dir="rtl"] span.value,
html[dir="rtl"] .coord,
html[dir="rtl"] span.coordinates {
    direction: ltr;
    unicode-bidi: isolate;
    display: inline-block;
}

/* ---------------------------------------------------------------------
 * 2) Header navigation (#header / #mtop icon row)
 * ---------------------------------------------------------------------
 * #mtop itself stays LTR (see above) because its icons are matched to
 * fixed sprite offsets from compact.css. What DOES need to flip is
 * everything OUTSIDE that icon cluster: the overall page reads RTL,
 * so #header should sit correctly, and any header content that later
 * uses flexbox/grid in this codebase should read end-to-start.
 */
html[dir="rtl"] #header {
    text-align: right;
}

/* ---------------------------------------------------------------------
 * 3) Main 3-column layout: side_navi (left menu) / content / side_info
 * ---------------------------------------------------------------------
 * Original LTR order (document order, all float:left):
 *   #side_navi -> #content -> #side_info
 * In RTL reading order the player menu should be the column closest
 * to the reading start (right edge) and the village-list/quests/news
 * column should sit at the reading end (left edge) - i.e. their
 * FLOATS swap, not their DOM order (we do not touch the templates).
 */
html[dir="rtl"] #side_navi {
    float: right;
    text-align: right;
}
html[dir="rtl"] #side_navi p a {
    padding-left: 0;
    padding-right: 12px;
}
html[dir="rtl"] #side_navi td.link {
    padding-right: 0;
    padding-left: 10px;
}

html[dir="rtl"] #side_info {
    float: left;
    padding-left: 0;
    padding-right: 10px;
    text-align: right;
}
html[dir="rtl"] #side_info h5,
html[dir="rtl"] #side_info div.news {
    margin-left: 0;
    margin-right: 10px;
}
html[dir="rtl"] #side_info div.news h5 {
    margin-right: 0;
}
html[dir="rtl"] #side_info div.news ul {
    margin-left: 0;
    margin-right: 15px;
}
html[dir="rtl"] #side_info td.dot {
    text-align: right;
}
html[dir="rtl"] #side_info td.link {
    padding-right: 0;
    padding-left: 10px;
}

/* #content keeps float:left in the source (compact.css); it sits
   naturally between the two flipped side columns either way, so no
   change needed there - only its internal text alignment. */
html[dir="rtl"] #content {
    text-align: right;
}
html[dir="rtl"] #content h1,
html[dir="rtl"] #content h2,
html[dir="rtl"] #content h3 {
    text-align: right;
}

/* Village name heading has an absolutely-positioned loyalty badge
   (div#loyality) anchored with the game's own left/right; leave its
   own positioning alone but make sure the heading text reads RTL. */
html[dir="rtl"] div.village1 h1 {
    text-align: right;
}

/* ---------------------------------------------------------------------
 * 4) Tables (reports, messages, rankings, movements, production)
 * ---------------------------------------------------------------------
 * Logical text-align so header/body cells read from the correct edge.
 * We do not touch column DOM order - browsers already right-align
 * table flow correctly once dir="rtl" is set on an ancestor; this
 * just fixes explicit left/center overrides already baked into the
 * markup/CSS.
 */
html[dir="rtl"] table {
    direction: rtl;
}
html[dir="rtl"] table th,
html[dir="rtl"] table td {
    text-align: right;
}
/* Numeric / icon-only columns stay centered or LTR-isolated instead
   of flipping to right, since a single icon or number does not read
   as RTL text. */
html[dir="rtl"] table td.ico,
html[dir="rtl"] table td.num,
html[dir="rtl"] table td.sel,
html[dir="rtl"] table td.dot {
    text-align: center;
    direction: ltr;
}
html[dir="rtl"] div.village1 table#movements td.dur_l,
html[dir="rtl"] div.village1 table#movements div.dur_r,
html[dir="rtl"] div.village1 table#movements div.dur_l {
    direction: ltr;
    unicode-bidi: isolate;
}

/* Timestamps and durations anywhere in tables (reports, messages,
   movements) - keep numbers/colons in their natural order. */
html[dir="rtl"] td.dat,
html[dir="rtl"] td.sent,
html[dir="rtl"] .time,
html[dir="rtl"] span.time {
    direction: ltr;
    unicode-bidi: isolate;
    text-align: right;
}

/* Message list pagination arrows (&laquo;/&raquo;) are typographic
   quote marks whose "next/prev" meaning flips with reading direction;
   CSS alone can't swap the glyphs safely without touching the PHP
   that prints them, so we leave the glyphs untouched here and only
   fix the surrounding cell alignment. */
html[dir="rtl"] th.navi {
    text-align: left;
}

/* ---------------------------------------------------------------------
 * 5) Forms
 * ---------------------------------------------------------------------
 */
html[dir="rtl"] form {
    text-align: right;
}
html[dir="rtl"] input[type="text"],
html[dir="rtl"] input[type="password"],
html[dir="rtl"] input[type="email"],
html[dir="rtl"] input[type="search"],
html[dir="rtl"] textarea,
html[dir="rtl"] select {
    text-align: right;
    direction: rtl;
}
/* Fields that only ever hold LTR technical content keep reading LTR
   even inside an RTL form (coordinates, e-mail-like usernames, world
   speed numbers, search-by-id boxes). */
html[dir="rtl"] input[type="text"].coordinatesInput,
html[dir="rtl"] input#xCoordInput,
html[dir="rtl"] input#yCoordInput,
html[dir="rtl"] div#map_coords input.text,
html[dir="rtl"] input[name="email"],
html[dir="rtl"] input[type="email"],
html[dir="rtl"] input[type="url"],
html[dir="rtl"] input.ltr-field {
    direction: ltr;
    text-align: right;
    unicode-bidi: isolate;
}
html[dir="rtl"] label {
    text-align: right;
}
html[dir="rtl"] input.check,
html[dir="rtl"] input[type="checkbox"],
html[dir="rtl"] input[type="radio"] {
    margin-left: 4px;
    margin-right: 0;
}
html[dir="rtl"] .trav_buttons,
html[dir="rtl"] button {
    padding-left: 20px;
    padding-right: 20px;
}

/* ---------------------------------------------------------------------
 * 6) Popups / dialogs (build popup overlay, generic .overlay pattern)
 * ---------------------------------------------------------------------
 */
html[dir="rtl"] .overlay_content {
    text-align: right;
    direction: rtl;
}
html[dir="rtl"] .overlay_content .closer {
    left: 8px;
    right: auto;
}
html[dir="rtl"] #buildPopupBody {
    text-align: right;
}
html[dir="rtl"] div.popup3 {
    text-align: right;
}

/* ---------------------------------------------------------------------
 * 7) Footer
 * ---------------------------------------------------------------------
 */
html[dir="rtl"] #footer div.footer-menu,
html[dir="rtl"] #footer div#mfoot,
html[dir="rtl"] #footer div#mfoot div.copyright {
    text-align: center;
}
html[dir="rtl"] #footer ul.menu {
    right: auto;
}
html[dir="rtl"] #footer ul.menu.menu2 {
    right: auto;
    left: 210px;
}
html[dir="rtl"] #footer ul.menu li {
    float: right;
}
/* Copyright line mixes a Latin server name/version with punctuation;
   keep it a single isolated LTR run so the year/name don't reorder. */
html[dir="rtl"] #footer div#mfoot div.copyright {
    direction: ltr;
    unicode-bidi: isolate;
}

/* ---------------------------------------------------------------------
 * 8) Plus / Gold Club - extend the .lang_rtl pattern already started
 * in Templates/Plus/*.tpl to the rest of that section consistently.
 * ---------------------------------------------------------------------
 */
html[dir="rtl"] div.plus table.lang_rtl {
    direction: rtl;
}
html[dir="rtl"] div.plus div#products table.lang_rtl {
    float: right;
}
html[dir="rtl"] div.plus p#product_selection,
html[dir="rtl"] div.plus p#orders_link {
    text-align: left;
}

/* ---------------------------------------------------------------------
 * 9) Alliance / forum, ranking pages - generic left/right utility
 * classes used throughout many .tpl files without IDs of their own.
 * ---------------------------------------------------------------------
 */
html[dir="rtl"] .left {
    text-align: right;
}
html[dir="rtl"] .right {
    text-align: left;
}
html[dir="rtl"] div.c1 {
    text-align: center;
}

/* ---------------------------------------------------------------------
 * 9b) Building interior pages (Templates/Build/*.tpl)
 * ---------------------------------------------------------------------
 * A handful of building templates (wall buildings: CityWall/EarthWall/
 * Palisade/StoneWall/MakeshiftWall/DefensiveWall/Barricade) float their
 * illustration image to one side with the description text wrapping
 * around it, using an INLINE style attribute. Inline styles win over
 * normal stylesheet rules, so this needs !important to actually mirror
 * the image to the opposite side in RTL - scoped to this one class only,
 * nothing else in the game is affected.
 */
html[dir="rtl"] img.wall-model {
    float: left !important;
    margin: 2px 14px 10px 0 !important;
}
html[dir="rtl"] p.build_desc {
    text-align: right;
}

/* ---------------------------------------------------------------------
 * 10) Responsive / mobile
 * ---------------------------------------------------------------------
 * The mobile strategy in gpack/_responsive/responsive.css scales the
 * whole absolutely-positioned game with `transform: scale(...)` rather
 * than reflowing it, specifically to avoid breaking the map/village
 * pixel coordinates. That strategy is direction-agnostic (it scales
 * whatever is already laid out) so it needs no RTL-specific change;
 * we only make sure text-flow chrome still reads correctly at small
 * sizes, same as desktop.
 */
@media screen and (max-width: 640px) {
    html[dir="rtl"] #side_navi,
    html[dir="rtl"] #side_info {
        text-align: right;
    }
}
