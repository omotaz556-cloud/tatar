     function tz_rtl_stylesheet_tag($langCode = null, $relPath = '') {
         $langCode = $langCode ?? (defined('LANG') ? LANG : 'en');
         if (!tz_is_rtl_lang($langCode)) {
             return '';
         }
+
+        $tag = '';
+
+        // (1) Optional per-gpack override (legacy hook). Some gpacks may
